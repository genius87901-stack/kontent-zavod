@echo off
rem РЕЗЕРВНАЯ КОПИЯ — файл для двойного щелчка.
rem
rem Самый простой путь из возможных: человек, который никогда не открывал
rem терминал, открывает папку завода и щёлкает по этому файлу. Ни команд, ни
rem путей, ни флагов. Дальше на экране будет ссылка и восьмизначный код — их
rem нужно открыть в браузере, и всё.
rem
rem Раскладки ДВЕ, и файл обязан работать в обеих: в коробке движок лежит в
rem корне, в заводе маркетолога — в engine\. Проверяем по факту, а не гадаем.
chcp 65001 >nul 2>&1
if exist "%~dp0engine\github_backup.py" (
    call "%~dp0zavod.cmd" "%~dp0engine\github_backup.py" --включи
) else (
    call "%~dp0zavod.cmd" "%~dp0github_backup.py" --включи
)
echo.
echo Окно можно закрыть.
pause >nul
